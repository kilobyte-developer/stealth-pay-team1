# ---------------------------------------------------------------------------
# StealthPay contracts — Fuji TESTNET only.
#
# Copy to `contracts/.env`. Never commit the real file (it is gitignored).
# Use a DEDICATED testnet wallet. Never put a mainnet key here.
# ---------------------------------------------------------------------------

# Optional: defaults to the public Avalanche Fuji endpoint.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Private key of a dedicated Fuji deployer, 0x-prefixed.
# Fund it from https://core.app/tools/testnet-faucet/
DEPLOYER_PRIVATE_KEY=

# Filled in automatically by the deploy scripts (written to deployments/fuji.json).
# Set manually only to override.
FUJI_ANNOUNCER_ADDRESS=
FUJI_PAYMENT_ROUTER_ADDRESS=
