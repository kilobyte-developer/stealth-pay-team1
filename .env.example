# =============================================================================
# StealthPay — environment template (Next.js app, repo root)
#
#   cp .env.example .env.local      # then fill in the values marked REQUIRED
#
# .env.local is gitignored. Never commit it, never paste it anywhere, and never
# put a real-funds key in it. This template contains NO secrets: every value
# below is either blank or a public on-chain fact (deployed Fuji contract
# addresses from contracts/deployments/fuji.json, public URLs).
#
# Two kinds of variable:
#   NEXT_PUBLIC_*  PUBLIC  — embedded in the browser bundle. Never a secret.
#   everything else  SERVER-ONLY — read by API routes only. Some are SECRET.
#
# Restart `npm run dev` after editing: Next.js reads env files at startup.
# Full first-time guide: docs/X402_INTEGRATION.md → "First-time setup".
# Contract deployment uses a separate file: contracts/.env.example.
# =============================================================================


# -----------------------------------------------------------------------------
# PUBLIC — Avalanche Fuji contracts (existing deployments; do not change)
# Source: contracts/deployments/fuji.json, verifiable on testnet.snowtrace.io
# -----------------------------------------------------------------------------

# REQUIRED for receiving — ERC-5564 Announcer. The scanner reads Announcement
# events from it, and the x402 relayer publishes announcements to it.
NEXT_PUBLIC_FUJI_ANNOUNCER_ADDRESS=0x576c07eba9A19e2c31da9359193b7f3F70a21342

# REQUIRED for AVAX/stUSD sends — StealthPaymentRouter (atomic pay + announce).
NEXT_PUBLIC_FUJI_ROUTER_ADDRESS=0xB14D5665f5BF628e8D297E252b0f09C4B42009cB

# OPTIONAL — stUSD test token (router ERC-20 path). Blank hides stUSD in Send.
# Note: stUSD does NOT support EIP-3009, so it can never be paid via x402.
NEXT_PUBLIC_FUJI_TEST_TOKEN_ADDRESS=0xB114A2B17F1E7b028249cCFec2D98D25a3Bbe9C0

# RECOMMENDED — block the scanner starts from: the Announcer's deployment
# block (creation tx 0x90c6ca69…6f1e). Blank/0 works but scans from genesis.
NEXT_PUBLIC_FUJI_SCAN_START_BLOCK=60645095


# -----------------------------------------------------------------------------
# PUBLIC — x402 (USDC via EIP-3009)
# -----------------------------------------------------------------------------

# REQUIRED for x402 — "true" shows "USDC (x402)" in Send. Anything else hides
# it. The server-side x402 variables below must also be set.
NEXT_PUBLIC_FUJI_X402_ENABLED=true

# OPTIONAL — leave BLANK on Fuji. Blank = Circle USDC on Fuji
# (0x5425890298aed601595a70AB815c96711a31Bc65, EIP-3009, domain "USD Coin"/"2").
# Only set for a local Hardhat chain (the local setup script writes it).
# The backend re-verifies EIP-3009 support at startup whatever is set here.
NEXT_PUBLIC_FUJI_X402_USDC_ADDRESS=


# -----------------------------------------------------------------------------
# PUBLIC — network overrides (normally leave alone)
# -----------------------------------------------------------------------------

# OPTIONAL — leave BLANK for public Fuji (https://api.avax-test.network/ext/bc/C/rpc).
# A loopback URL (http://127.0.0.1:8545) switches the app to LOCAL HARDHAT
# mode — set by contracts/scripts/local-x402-setup.ts, not by hand.
NEXT_PUBLIC_FUJI_RPC_URL=

# OPTIONAL — Snowtrace API used to speed up scanning. Keep this line COMMENTED
# OUT: unset = https://api-testnet.snowtrace.io/api, but an EMPTY value
# disables the fast path (slow 100-block RPC scanning instead).
# NEXT_PUBLIC_FUJI_EXPLORER_API_URL=https://api-testnet.snowtrace.io/api

# NOT USED — Avalanche mainnet is out of scope. Leave blank.
NEXT_PUBLIC_MAINNET_ANNOUNCER_ADDRESS=
NEXT_PUBLIC_MAINNET_ROUTER_ADDRESS=
NEXT_PUBLIC_MAINNET_TEST_TOKEN_ADDRESS=
NEXT_PUBLIC_MAINNET_SCAN_START_BLOCK=0


# -----------------------------------------------------------------------------
# SERVER-ONLY — x402 payments (needed to send/receive USDC via x402)
# Never prefix these with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------

# REQUIRED for x402 — x402 facilitator that verifies and settles EIP-3009
# payments. PayAI's hosted facilitator supports scheme "exact" on Fuji
# (network "eip155:43113"); check: curl https://facilitator.payai.network/supported
# No API key is used. (Local Hardhat uses http://127.0.0.1:4022 instead.)
X402_FACILITATOR_URL=https://facilitator.payai.network

# REQUIRED for x402 — SECRET. 0x-prefixed private key (66 chars) of a NEW,
# DEDICATED Fuji-only "relayer" account. It only sends Announcer.announce()
# after a payment is confirmed on-chain; it never holds tokens. Fund its
# ADDRESS with ~0.05–0.1 Fuji AVAX for gas. There is no separate address
# variable: the address is derived from this key (see the setup guide for a
# command that generates the key here and prints only the address).
# Never use a key that holds real funds, and never the Hardhat test keys.
# Blank = x402 API answers 503 "x402_not_configured".
STEALTHPAY_RELAYER_PRIVATE_KEY=

# OPTIONAL — RPC for the x402 backend. Blank = same RPC as the app.
X402_FUJI_RPC_URL=

# OPTIONAL — JSON file holding x402 payment state (public data only: addresses,
# amounts, tx hashes). Blank = .stealthpay/x402-payments.json (gitignored).
STEALTHPAY_X402_STORE_PATH=


# -----------------------------------------------------------------------------
# SERVER-ONLY — dev-only debug log (OPTIONAL; see docs/DEBUG_LOG.md)
# Both blank = debug logging silently disabled; payments are unaffected.
# -----------------------------------------------------------------------------

# OPTIONAL — Supabase project URL (Project Settings → API).
SUPABASE_URL=

# OPTIONAL — SECRET. Supabase SERVICE ROLE key (not the anon key). Full
# database access: server-only, never NEXT_PUBLIC_, never shared.
SUPABASE_SERVICE_ROLE_KEY=
